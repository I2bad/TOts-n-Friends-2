Options -MultiViews
RewriteEngine On

# ─── SPA routing ─────────────────────────────────────────────────────────
# Redirect /index.html → / so React Router always sees clean paths.
RewriteRule ^index\.html$ / [R=301,L]

# Canonicalize — strip trailing slashes on prerendered routes so each page
# has exactly one URL (e.g. /contact, not /contact/).
RewriteRule ^(contact|philosophy|timeline)/$ /$1 [R=301,L]

# Serve prerendered static HTML for known routes (unique title / OG per page).
RewriteRule ^contact$    contact/index.html    [L]
RewriteRule ^philosophy$ philosophy/index.html [L]
RewriteRule ^timeline$   timeline/index.html   [L]

# Send every other non-file, non-directory request to index.html so React
# Router handles it client-side.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# ─── Security headers ────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # HSTS — force HTTPS for 1 year, include subdomains, allow preload list
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"

    # MIME sniffing protection
    Header always set X-Content-Type-Options "nosniff"

    # Referrer policy — balances SEO analytics with user privacy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions policy — deny powerful APIs we don't use
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Cross-Origin-Opener-Policy — mitigates cross-origin attacks
    Header always set Cross-Origin-Opener-Policy "same-origin"

    # Content Security Policy
    # Allow Spline, Google Fonts, CDNFonts, inline styles/scripts needed by React,
    # and images/data-urls from self.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://prod.spline.design https://unpkg.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.cdnfonts.com; font-src 'self' data: https://fonts.gstatic.com https://fonts.cdnfonts.com; img-src 'self' data: blob: https:; connect-src 'self' https://prod.spline.design https://unpkg.com https://tnf.tpi.edu.my https://www.gstatic.com; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self';"
</IfModule>

# ─── Caching — static assets ─────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Images & fonts — cache 1 year (fingerprinted by Vite)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # CSS & JS — cache 1 year (fingerprinted filenames)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/json "access plus 1 day"

    # HTML — short cache so updates deploy quickly
    ExpiresByType text/html "access plus 1 hour"

    # SEO files — refresh often
    ExpiresByType text/plain "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ─── Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ─── MIME types ──────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/xml .xml
    AddType text/plain .txt
    AddType image/webp .webp
</IfModule>
